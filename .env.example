# claude-slack-bridge — environment configuration example
#
# Copy to .env (or export these in your shell / service unit).
# Environment variables override values in ~/.claude-slack-bridge/config.json.

# Slack bot token — starts with xoxb- (OAuth & Permissions → Bot User OAuth Token)
CLAUDE_SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack app-level token — starts with xapp- (Basic Information → App-Level Tokens,
# needs the connections:write scope). Required for Socket Mode.
CLAUDE_SLACK_APP_TOKEN=xapp-your-app-level-token

# Optional: comma-separated Slack user IDs that are pre-authorized.
# Everyone else must authenticate with the challenge code on first contact.
CLAUDE_SLACK_ALLOWED_USERS=

# Optional: one-time challenge code handed out to new users.
CLAUDE_SLACK_CHALLENGE_CODE=

# Optional: default working directory for new Claude sessions.
CLAUDE_SLACK_WORKDIR=

# Optional: model alias or full name (sonnet | opus | haiku | claude-...).
CLAUDE_SLACK_MODEL=

# Optional: default permission mode for new sessions.
# default | acceptEdits | plan | dontAsk | bypassPermissions | auto
CLAUDE_SLACK_PERMISSION_MODE=
